@echo off
REM Generated by v32c++ from the source's own cart hints and command line. Edit
REM the source (or use --no-build-scripts and keep a hand-written script)
REM rather than this file: it is rewritten on every v32c++ run.

REM the tools this build needs
where v32c++ >nul 2>nul
if errorlevel 1 (
    echo ERROR: v32c++ is needed to build, but was not found in PATH
    goto :failed
)
where compile >nul 2>nul
if errorlevel 1 (
    echo ERROR: compile is needed to build, but was not found in PATH
    goto :failed
)
where assemble >nul 2>nul
if errorlevel 1 (
    echo ERROR: assemble is needed to build, but was not found in PATH
    goto :failed
)
where packrom >nul 2>nul
if errorlevel 1 (
    echo ERROR: packrom is needed to build, but was not found in PATH
    goto :failed
)
where png2vircon >nul 2>nul
if errorlevel 1 (
    echo ERROR: png2vircon is needed to build, but was not found in PATH
    goto :failed
)
where wav2vircon >nul 2>nul
if errorlevel 1 (
    echo ERROR: wav2vircon is needed to build, but was not found in PATH
    goto :failed
)

REM the optimizer is optional: without it only the regular build is made
set HAVE_OPT=0
where v32opt >nul 2>nul
if not errorlevel 1 set HAVE_OPT=1
if "%HAVE_OPT%"=="0" echo note: v32opt not found in PATH -- skipping the optimized Opt build

REM create the output folders, since the development tools will not
if not exist bin mkdir bin
if not exist obj mkdir obj

echo.
echo Transpile to Vircon32 C
echo --------------------------
v32c++ -b --no-build-scripts -o obj\debuggerBIOS-ng.c debuggerBIOS-ng.cpp || goto :failed

echo.
echo Compile the C code
echo --------------------------
compile -b obj\debuggerBIOS-ng.c -o obj\debuggerBIOS-ng.asm || goto :failed
if "%HAVE_OPT%"=="1" v32opt -O3 obj\debuggerBIOS-ng.asm -o obj\debuggerBIOS-ngOpt.asm || goto :failed

echo.
echo Assemble the ASM code
echo --------------------------
assemble -b obj\debuggerBIOS-ng.asm -o obj\debuggerBIOS-ng.vbin || goto :failed
if "%HAVE_OPT%"=="1" assemble -b obj\debuggerBIOS-ngOpt.asm -o obj\debuggerBIOS-ngOpt.vbin || goto :failed

echo.
echo Convert the PNG textures
echo --------------------------
png2vircon assets\BiosTexture.png -o obj\BiosTexture.vtex || goto :failed

echo.
echo Convert the WAV sounds
echo --------------------------
wav2vircon assets\BiosSound.wav -o obj\BiosSound.vsnd || goto :failed

echo.
echo Pack the ROM
echo --------------------------
packrom obj\debuggerBIOS-ng.xml -o bin\debuggerBIOS-ng.v32 || goto :failed
if "%HAVE_OPT%"=="1" packrom obj\debuggerBIOS-ngOpt.xml -o bin\debuggerBIOS-ngOpt.v32 || goto :failed
goto :succeeded

:failed
echo.
echo BUILD FAILED
exit /b 1

:succeeded
echo.
echo BUILD SUCCESSFUL
exit /b 0
